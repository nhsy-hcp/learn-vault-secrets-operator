{
  "role_type": "jwt",
  "policies": ["entity-secret"],
  "user_claim": "/kubernetes.io/serviceaccount/name",
  "user_claim_json_pointer": true,
  "bound_claims_type":"glob",
  "bound_claims": {
    "/kubernetes.io/namespace": ["entity-app-*"],
    "/kubernetes.io/serviceaccount/name": ["entity-app-*-sa"]
  },
  "claim_mappings": {
    "/kubernetes.io/namespace": "namespace",
    "/kubernetes.io/serviceaccount/name": "service_account_name"
  },
  "bound_audiences": "vault",
  "token_period": 3600
}
