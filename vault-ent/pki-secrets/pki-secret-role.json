{
  "role_type": "jwt",
  "policies": ["pki-secret"],
  "user_claim": "/kubernetes.io/serviceaccount/name",
  "user_claim_json_pointer": true,
  "bound_claims_type": "glob",
  "bound_claims": {
    "/kubernetes.io/namespace": ["pki-app-*"],
    "/kubernetes.io/serviceaccount/name": ["pki-app-sa"]
  },
  "bound_audiences": "vault",
  "token_period": 3600
}
